rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function connecte() { return request.auth != null; }
    function gestionnaire() { return connecte() && request.auth.token.email == "marius.fumont@gmail.com"; }
    function moi(c) { return /databases/$(database)/documents/$(c)/$(request.auth.uid); }
    function enEssai(c) { return exists(moi(c)) && request.time < get(moi(c)).data.cree + duration.value(7, 'd'); }
    function abonne(c) { return exists(moi(c)) && request.time < get(moi(c)).data.jusqu; }
    function acces() { return connecte() && (gestionnaire() || abonne("abonnes") || enEssai("comptes")); }
    function accesSA() { return connecte() && (gestionnaire() || abonne("sa_abonnes") || enEssai("sa_comptes")); }
    function accesSACN() { return connecte() && (gestionnaire() || abonne("sacn_abonnes") || enEssai("sacn_comptes")); }

    match /users/{userId}/{document=**} {
      allow read: if (connecte() && request.auth.uid == userId) || gestionnaire();
      allow write: if connecte() && request.auth.uid == userId;
    }

    match /comptes/{uid} {
      allow read: if (connecte() && request.auth.uid == uid) || gestionnaire();
      allow create: if connecte() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'cree', 'vu'])
        && request.resource.data.cree == request.time;
      allow update: if (connecte() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vu']))
        || gestionnaire();
      allow delete: if gestionnaire();
    }
    match /sa_comptes/{uid} {
      allow read: if (connecte() && request.auth.uid == uid) || gestionnaire();
      allow create: if connecte() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'cree', 'vu'])
        && request.resource.data.cree == request.time;
      allow update: if (connecte() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vu']))
        || gestionnaire();
      allow delete: if gestionnaire();
    }

    match /sacn_comptes/{uid} {
      allow read: if (connecte() && request.auth.uid == uid) || gestionnaire();
      allow create: if connecte() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'cree', 'vu'])
        && request.resource.data.cree == request.time;
      allow update: if (connecte() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vu']))
        || gestionnaire();
      allow delete: if gestionnaire();
    }

    match /abonnes/{uid} {
      allow read: if (connecte() && request.auth.uid == uid) || gestionnaire();
      allow write: if gestionnaire();
    }
    match /sa_abonnes/{uid} {
      allow read: if (connecte() && request.auth.uid == uid) || gestionnaire();
      allow write: if gestionnaire();
    }
    match /sacn_abonnes/{uid} {
      allow read: if (connecte() && request.auth.uid == uid) || gestionnaire();
      allow write: if gestionnaire();
    }

    match /contenu/{doc} { allow read: if acces(); allow write: if gestionnaire(); }
    match /sa_contenu/{doc} { allow read: if accesSA(); allow write: if gestionnaire(); }
    match /sacn_contenu/{doc} { allow read: if accesSACN(); allow write: if gestionnaire(); }

    match /config/cle { allow read: if acces(); allow write: if gestionnaire(); }
    match /config/sa_cle { allow read: if accesSA(); allow write: if gestionnaire(); }
    match /config/sacn_cle { allow read: if accesSACN(); allow write: if gestionnaire(); }
    match /config/admin { allow read: if gestionnaire(); }
    match /config/paiement { allow read: if connecte(); allow write: if gestionnaire(); }
    match /config/sa_paiement { allow read: if connecte(); allow write: if gestionnaire(); }
    match /config/sacn_paiement { allow read: if connecte(); allow write: if gestionnaire(); }
    match /config/ia { allow read: if connecte(); allow write: if gestionnaire(); }
  }
}
